# ---- FFUF Online — environment configuration (copy to .env) ----

# ---------- Control plane (Go) ----------
API_ADDR=:8080
API_PUBLIC_URL=http://localhost:8080

# storage driver: memory | postgres
STORAGE=memory

# event bus driver: inprocess | nats
EVENT_BUS=inprocess

# worker dispatch driver: memory | nats
DISPATCH=memory

# JWT signing for user sessions
JWT_SECRET=dev-only-change-me
JWT_TTL_MINUTES=720

# worker job signing (HMAC-SHA256 over canonical JSON)
JOB_SIGNING_SECRET=dev-only-change-me-too
JOB_TTL_SECONDS=300

# ---------- Databases ----------
# Set STORAGE=postgres to use these.
DATABASE_URL=postgres://ffuf:ffuf@localhost:5432/ffuf_online?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

# ---------- Scope engine (Rust) ----------
SCOPE_ENGINE_URL=http://localhost:8090
SCOPE_ENGINE_ADDR=0.0.0.0:8090
# Path to the compiled binary used by the Python/Go subprocess fallback path.
SCOPE_ENGINE_BIN=rust/scope-engine/target/release/scope-engine
# Hard-blocked destination classes. Never disable in production.
EGRESS_BLOCK_PRIVATE=true
EGRESS_BLOCK_METADATA=true
EGRESS_BLOCK_LOOPBACK=true
EGRESS_REVALIDATE_REDIRECTS=true

# ---------- Intelligence engine (Python) ----------
INTEL_TENANT_MAX_TASKS=400
INTEL_MAX_WORKFLOW_DEPTH=5
INTEL_MAX_TASKS_PER_ASSET=12
INTEL_TASK_COOLDOWN_SECONDS=900
INTEL_MAX_TASKS_PER_PROJECT_RUN=1500

# ---------- Tool execution ----------
# docker | local   (local is for development and CI only)
TOOL_RUNNER=docker
TOOL_TIMEOUT_SECONDS=900
TOOL_CPU_LIMIT=1.0
TOOL_MEMORY_LIMIT=1g
TOOL_NETWORK=none
# Allowlist of directories the local runner may execute binaries from.
TOOL_LOCAL_BINDIR=python/tools/bin

# ---------- AI (optional; never controls security boundaries) ----------
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
